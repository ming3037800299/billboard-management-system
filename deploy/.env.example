# ============================================================
# 生产部署配置
# 复制为 .env 后填写；.env 含密码和密钥，不要提交到代码仓库。
# ============================================================

TZ=Asia/Shanghai

# 公网访问端口。阿里云安全组必须放行同一端口。
# 没有域名 / 未备案时建议使用 8080；有域名和备案可改为 80。
HTTP_PORT=8080
# 监听地址。直接公网访问用 0.0.0.0；前置 Caddy/Nginx 后可改为 127.0.0.1
BIND_IP=0.0.0.0

# ---------- MySQL ----------
# 仅被 Docker 内部使用，不会对公网开放 3306
DB_USERNAME=jqgg_glm53_user
DB_PASSWORD=replace-with-strong-db-password
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password

# ---------- 后台管理 ----------
ADMIN_PASSWORD=replace-with-strong-admin-password

# ---------- 知识库 / 问答模型 ----------
# 留空则智能选牌只返回检索结果，不生成自然语言回答
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_MAX_TOKENS=2000
RAG_ENABLED=true
RAG_MIN_SCORE=0.5

# 向量模型：2GB 内存使用随包附带的轻量模型；8GB 可切换为 bge-m3
# bge-m3: RAG_MODEL_DIR=model, EMBEDDING_MODEL=bge-m3, EMBEDDING_MAX_LENGTH=2048
RAG_MODEL_DIR=model-small
EMBEDDING_MODEL=bge-small-zh-v1.5
EMBEDDING_MAX_LENGTH=512

# ---------- 腾讯地图 ----------
# 正式域名确定后，建议在腾讯位置服务控制台把新域名加入该 Key 的白名单
MAP_AK=FHWBZ-IFT34-DWJUN-KBHKF-2ALPS-KABBG

# ---------- JVM ----------
# 2GB 机器使用 384MB 堆；8GB 机器可调到 -Xmx768m
JAVA_OPTS=-Xms128m -Xmx384m -XX:+UseG1GC -Dfile.encoding=UTF-8 -Duser.timezone=Asia/Shanghai
